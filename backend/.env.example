# ==============================================================================
# SECUREBANK BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `backend/.env` and update the values with your local settings.
# Never commit `.env` containing real credentials to version control.

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-string
JWT_SECRET_KEY=change-this-jwt-secret-in-production-to-a-secure-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Server Bindings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 17 via Psycopg 3)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
#
# IMPORTANT: If your password contains special characters like '@', ':', '/', '#',
# you MUST URL-encode them. Example: 'P@ss#123' becomes 'P%40ss%23123'.
#
# Local PostgreSQL connection (set credentials in your ignored backend/.env):
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/securebank

# Set these only in ignored backend/.env when creating missing demo users.
DEMO_CLIENT_PASSWORD=
DEMO_AUDITOR_PASSWORD=

# ------------------------------------------------------------------------------
# Azure Compute Study Label (does not verify Azure deployment or attestation)
# ------------------------------------------------------------------------------
# Allowed study labels: LOCAL_UNVERIFIED, AZURE_CONFIDENTIAL_VM,
# AZURE_ISOLATED_VM, or AZURE_STANDARD_VM. Non-local labels are unverified.
COMPUTE_ENVIRONMENT=LOCAL_UNVERIFIED
